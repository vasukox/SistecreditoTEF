<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifest del APK Abonos Sistecredito.

  Diferencias con el TEF:
    - Sin [IntentFilter] de HI-POS (este APK NO responde a icg.actions.*)
    - Solo aparece en el launcher (android.intent.action.MAIN + LAUNCHER)
    - ApplicationId distinto (com.permoda.sistecreditotef.abonos)
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="Sistecredito Abonos"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.SistecreditoTEF" />

</manifest>