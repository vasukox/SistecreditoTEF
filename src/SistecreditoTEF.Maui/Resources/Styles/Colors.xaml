<?xml version="1.0" encoding="utf-8"?>
<!--
    ════════════════════════════════════════════════════════════════════════════
    Sistema de color v4 — paleta de marca
    ════════════════════════════════════════════════════════════════════════════
    Los cuatro colores de la identidad:

      #f2f2f2  gris claro    limpieza y versatilidad  → fondo de las pantallas
      #e0e275  verde lima    energía y frescura       → acento
      #4554a1  azul intenso  confianza y solidez      → color de acción principal
      #333333  gris oscuro   carácter y fuerza        → texto y superficies oscuras

    ────────────────────────────────────────────────────────────────────────────
    DOS REGLAS QUE NO SE PUEDEN ROMPER
    ────────────────────────────────────────────────────────────────────────────
    1. EL VERDE LIMA NUNCA LLEVA TEXTO BLANCO. Es un amarillo-verde muy claro
       (luminancia alta): blanco sobre lima da un contraste de ~1.3:1, ilegible.
       Sobre lima va SIEMPRE [TextPrimary] (#333333), que da ~9:1. Por eso el
       token que lo acompaña se llama [OnAccent] y vale gris oscuro, no blanco.

    2. El azul SÍ lleva texto blanco (~6.6:1, cumple AA). Es el unico de los
       cuatro que puede.

    Esto importa de verdad en un POS: la pantalla se lee de pie, con reflejos y a
    veces a contraluz. Un texto de bajo contraste ahi no es un detalle estetico,
    es un monto que el cajero lee mal.

    ────────────────────────────────────────────────────────────────────────────
    SOBRE LOS COLORES SEMANTICOS
    ────────────────────────────────────────────────────────────────────────────
    Error, Warning y Success NO salen de la paleta de marca, y es a proposito.
    Esta aplicacion mueve plata: un aviso de "abono en duda, no vuelvas a cobrar"
    tiene que leerse como advertencia universal, no como un tono de la identidad.
    Se armonizaron con la paleta pero conservan su significado.

    Las claves se mantuvieron todas: las vistas siguen funcionando sin cambios.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ===== Marca ===== -->

    <!-- Azul intenso: confianza y solidez. Color de accion principal. -->
    <Color x:Key="Primary">#4554A1</Color>
    <Color x:Key="PrimaryDark">#36427F</Color>
    <Color x:Key="PrimaryLight">#6D79BC</Color>
    <Color x:Key="PrimaryVivid">#4554A1</Color>

    <!-- Azul al 10%: fondo de botones secundarios, con texto PrimaryDark. -->
    <Color x:Key="PrimaryTint">#E4E7F4</Color>

    <!-- Verde lima: energía y frescura. SOLO con texto oscuro (regla 1). -->
    <Color x:Key="Accent">#E0E275</Color>
    <Color x:Key="AccentLight">#EDEEB0</Color>
    <Color x:Key="AccentDark">#C6C845</Color>

    <!-- Color de texto que va ENCIMA del acento. Nunca blanco. -->
    <Color x:Key="OnAccent">#333333</Color>

    <!-- ===== Superficies ===== -->
    <Color x:Key="White">#FFFFFFFF</Color>
    <Color x:Key="Black">#FF000000</Color>

    <!-- Gris claro de la paleta: fondo de las pantallas. -->
    <Color x:Key="Background">#F2F2F2</Color>
    <Color x:Key="Surface">#FFFFFF</Color>

    <!-- Un paso mas oscuro que Background, para chips sobre tarjetas blancas. -->
    <Color x:Key="SurfaceAlt">#EDEDED</Color>

    <!-- Gris oscuro de la paleta: barra superior y superficies oscuras. -->
    <Color x:Key="NavSurface">#333333</Color>
    <Color x:Key="NavSurfaceAlt">#3F3F3F</Color>

    <Color x:Key="Divider">#DEDEDE</Color>
    <Color x:Key="Border">#DEDEDE</Color>
    <Color x:Key="ShadowColor">#333333</Color>

    <!-- ===== Texto ===== -->
    <Color x:Key="TextPrimary">#333333</Color>
    <Color x:Key="TextSecondary">#6B6B6B</Color>
    <Color x:Key="TextMuted">#9A9A9A</Color>
    <Color x:Key="OnDark">#FFFFFF</Color>
    <Color x:Key="OnDarkMuted">#B4B4B4</Color>

    <!-- Sobre el hero, que ahora es azul: blanco y un azul muy claro. -->
    <Color x:Key="OnHero">#FFFFFF</Color>
    <Color x:Key="OnHeroMuted">#C9D0EC</Color>

    <!-- ===== Semanticos ===== -->
    <!-- Verde con suficiente contraste para texto blanco: el lima no sirve aca. -->
    <Color x:Key="Success">#2E7D52</Color>
    <Color x:Key="SuccessDark">#256843</Color>
    <Color x:Key="SuccessSoft">#E4F1EA</Color>

    <Color x:Key="Error">#B23A2A</Color>
    <Color x:Key="ErrorSoft">#F7E7E4</Color>
    <Color x:Key="Warning">#B26A00</Color>
    <Color x:Key="WarningSoft">#FBF0DE</Color>
    <Color x:Key="Info">#4554A1</Color>

    <!-- Fondo del elemento seleccionado: azul muy claro. -->
    <Color x:Key="SelectTint">#E4E7F4</Color>

    <!-- ═══════════════════════════════════════════════════════════════════════
         BRUSHES
         ═══════════════════════════════════════════════════════════════════════
         No son opcionales: [Styles.xaml] los referencia en HeroCard y en las
         sombras. Al reescribir este archivo se perdieron y la app dejo de
         arrancar — XamlParseException "StaticResource not found for key
         PrimaryBrush" al construir App, o sea antes de la primera pantalla.

         Los gradientes son de DOS TONOS CERCANOS del mismo azul, a proposito: un
         gradiente marcado en un POS se ve barato y ademas rompe el contraste del
         texto blanco encima, que en el hero lleva los montos.
    -->

    <!-- Hero: azul de marca con gradiente sutil. -->
    <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4E5DAE" Offset="0.0" />
        <GradientStop Color="#4554A1" Offset="0.5" />
        <GradientStop Color="#36427F" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Header del scaffold: mas oscuro hacia arriba-derecha. -->
    <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#4A59A6" Offset="0.0" />
        <GradientStop Color="#3D4A8E" Offset="0.55" />
        <GradientStop Color="#2C3667" Offset="1.0" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="PrimarySolidBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="ScreenBackgroundBrush" Color="{StaticResource Background}" />

</ResourceDictionary>
