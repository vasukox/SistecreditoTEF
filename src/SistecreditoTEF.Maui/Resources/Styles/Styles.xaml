<?xml version="1.0" encoding="utf-8"?>
<!--
    Sistema de estilos v3 — HU8-973 · design system POS (android-pos-frontend).
    Barra superior oscura, botones verdes de esquina recta (radio 4dp), targets
    de 64dp, tarjetas hairline, tipografía con etiquetas en mayúscula (tracking).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <SolidColorBrush x:Key="ShadowBrush" Color="{StaticResource ShadowColor}" />

    <!-- ============ SHELL (barra oscura) ============ -->
    <Style x:Key="DefaultShellStyle" TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource NavSurface}" />
        <Setter Property="Shell.ForegroundColor" Value="{StaticResource OnDark}" />
        <Setter Property="Shell.TitleColor" Value="{StaticResource OnDark}" />
        <Setter Property="Shell.DisabledColor" Value="{StaticResource OnDarkMuted}" />
        <Setter Property="Shell.UnselectedColor" Value="{StaticResource OnDarkMuted}" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource NavSurface}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource Primary}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource OnDark}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource OnDarkMuted}" />
    </Style>

    <!-- ============ PAGE ============ -->
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource Background}" />
    </Style>

    <!-- ============ DEFAULTS IMPLICITOS ============ -->
    <!--
        Sin estos, cada Label y cada Entry que no fije color explicito hereda el
        default de la plataforma. En un POS eso se nota: los placeholders salian
        casi invisibles sobre la tarjeta blanca, y el texto que el cajero escribe
        quedaba en un negro distinto del resto de la interfaz.

        Los estilos con clave y los colores puestos a mano siguen mandando: esto es
        solo el piso.
    -->
    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- El estilo implicito de Entry ya existe mas abajo; no se duplica. -->

    <!-- ============ TIPOGRAFIA ============ -->
    <Style TargetType="Label" x:Key="Display">
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="CharacterSpacing" Value="-0.5" />
    </Style>

    <Style TargetType="Label" x:Key="MoneyLarge">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="CharacterSpacing" Value="-0.5" />
    </Style>

    <Style TargetType="Label" x:Key="ScreenTitle">
        <Setter Property="FontSize" Value="23" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="CharacterSpacing" Value="-0.2" />
    </Style>

    <Style TargetType="Label" x:Key="ScreenSubtitle">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
    </Style>

    <Style TargetType="Label" x:Key="CardTitle">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
    </Style>

    <!-- label.caps: mayúscula, tracking amplio, muted -->
    <Style TargetType="Label" x:Key="FieldLabel">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="CharacterSpacing" Value="1.3" />
    </Style>

    <Style TargetType="Label" x:Key="Caption">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
    </Style>

    <Style TargetType="Label" x:Key="Body">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style TargetType="Label" x:Key="SuccessBigLabel">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="TextColor" Value="{StaticResource Success}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <!-- ============ TARJETAS ============ -->
    <Style TargetType="Border" x:Key="Card">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="Stroke" Value="{StaticResource Border}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource ShadowBrush}" Offset="0,2" Radius="12" Opacity="0.06" />
        </Setter>
    </Style>

    <Style TargetType="Border" x:Key="HeroCard">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource ShadowBrush}" Offset="0,6" Radius="18" Opacity="0.18" />
        </Setter>
    </Style>

    <Style TargetType="Border" x:Key="FieldCard">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="Stroke" Value="{StaticResource Border}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="20,4" />
        <Setter Property="StrokeShape" Value="RoundRectangle 26" />
    </Style>

    <!-- ============ BOTONES (esquina recta 4dp, target 60dp) ============ -->
    <Style TargetType="Button" x:Key="PrimaryButton">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="TextColor" Value="{StaticResource OnDark}" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource ShadowBrush}" Offset="0,3" Radius="10" Opacity="0.16" />
        </Setter>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="1" />
                            <Setter Property="Opacity" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="0.98" />
                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryDark}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource TextMuted}" />
                            <Setter Property="Opacity" Value="0.5" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="SuccessButton" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="BackgroundColor" Value="{StaticResource Success}" />
    </Style>

    <!--
        Boton de acento (verde lima).

        NO hereda de PrimaryButton a proposito. PrimaryButton trae
        TextColor=OnDark (blanco) y un estado Pressed que pinta el fondo de azul
        oscuro; las dos cosas estan mal sobre el lima:

          • Blanco sobre #E0E275 da ~1.3:1 de contraste. Ilegible, sobre todo en
            la pantalla de un POS con reflejos.
          • Al presionar se volveria azul, o sea otro color de la marca.

        Asi que el acento define su propio texto ([OnAccent] = gris oscuro, ~9:1)
        y su propio Pressed (una version mas oscura del mismo lima).
    -->
    <Style TargetType="Button" x:Key="AccentButton">
        <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
        <Setter Property="TextColor" Value="{StaticResource OnAccent}" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource ShadowBrush}" Offset="0,3" Radius="10" Opacity="0.16" />
        </Setter>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="1" />
                            <Setter Property="Opacity" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="0.98" />
                            <Setter Property="BackgroundColor" Value="{StaticResource AccentDark}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource SurfaceAlt}" />
                            <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
                            <Setter Property="Opacity" Value="0.6" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!--
        ════════════════════════════════════════════════════════════════════════
        SECUNDARIO — la acción que acompaña, no la que manda
        ════════════════════════════════════════════════════════════════════════
        Existe porque no existía, y por eso las acciones de segundo orden se
        escribían a mano en cada pantalla: BackgroundColor="Transparent",
        HeightRequest="46", sin esquina, sin sombra y sin estado de presión. Al
        lado de una píldora de 56dp con sombra, eso no se lee como un botón sino
        como una etiqueta que alguien olvidó terminar.

        Comparte GEOMETRÍA con el primario —misma altura, misma píldora, mismo
        peso de fuente— y se diferencia solo por el color: azul al 10% con texto
        azul oscuro. Esa es la forma correcta de bajar jerarquía en un POS: el
        dedo apunta igual de fácil, la vista sabe cuál es primero.

        La sombra es más suave que la del primario (0.10 contra 0.16): está
        apoyado en la tarjeta, no flotando encima.
    -->
    <Style TargetType="Button" x:Key="SecondaryButton">
        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryTint}" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryDark}" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource ShadowBrush}" Offset="0,2" Radius="8" Opacity="0.10" />
        </Setter>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="1" />
                            <Setter Property="Opacity" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="0.98" />
                            <Setter Property="BackgroundColor" Value="{StaticResource SelectTint}" />
                            <Setter Property="TextColor" Value="{StaticResource Primary}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource SurfaceAlt}" />
                            <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
                            <Setter Property="Opacity" Value="0.6" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!--
        ════════════════════════════════════════════════════════════════════════
        DELINEADO — tercer nivel, y sigue siendo un botón
        ════════════════════════════════════════════════════════════════════════
        Para la acción que casi nunca se usa pero tiene que estar (descartar,
        cerrar la ventana, escribir la dirección a mano). El borde es lo que la
        mantiene del lado de los botones: sin él vuelve a ser texto suelto, y un
        texto suelto en un POS nadie sabe si se toca.

        Al presionar se RELLENA en vez de solo encogerse: en una pantalla con
        reflejos, un cambio de área se ve y un cambio de 2% de escala no.
    -->
    <Style TargetType="Button" x:Key="OutlineButton">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="BorderColor" Value="{StaticResource Border}" />
        <Setter Property="BorderWidth" Value="1.5" />
        <Setter Property="CornerRadius" Value="26" />
        <Setter Property="HeightRequest" Value="50" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="1" />
                            <Setter Property="BackgroundColor" Value="Transparent" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="0.98" />
                            <Setter Property="BackgroundColor" Value="{StaticResource SurfaceAlt}" />
                            <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.45" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!--
        ════════════════════════════════════════════════════════════════════════
        PASTILLAS — botones dentro de una fila de lista
        ════════════════════════════════════════════════════════════════════════
        Los de la lista de cajeros ("Clave", "Quitar", "Activar") viven dentro de
        una fila, así que no pueden medir 56dp: compiten con el nombre del cajero,
        que es lo que hay que leer primero. Pero tampoco pueden ser texto plano —
        eran BackgroundColor="Transparent" sin borde, y así "Quitar" no se
        distinguía de una etiqueta.

        Son la misma píldora, en chico: 40dp, radio completo y el color dice qué
        hace. 40dp queda por debajo de los 48 recomendados para un dedo, y se
        acepta a propósito: van de a dos en una fila y agrandarlas empujaría el
        nombre fuera de pantalla. El acierto se ayuda con el espacio entre ellas.
    -->
    <Style TargetType="Button" x:Key="ChipButton">
        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryTint}" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryDark}" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="0.96" />
                            <Setter Property="BackgroundColor" Value="{StaticResource SelectTint}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Pastilla delineada: la acción de bajar a alguien no se ofrece rellena. -->
    <Style TargetType="Button" x:Key="ChipOutlineButton" BasedOn="{StaticResource ChipButton}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="BorderColor" Value="{StaticResource Border}" />
        <Setter Property="BorderWidth" Value="1.5" />
    </Style>

    <!-- Pastilla de acento: reactivar es devolverle el acceso a alguien. -->
    <Style TargetType="Button" x:Key="ChipAccentButton" BasedOn="{StaticResource ChipButton}">
        <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
        <Setter Property="TextColor" Value="{StaticResource OnAccent}" />
    </Style>

    <!--
        Delineado sobre el HERO azul. El borde y el texto grises desaparecen ahí,
        así que van en blanco translúcido. Mismo control, otro fondo.
    -->
    <Style TargetType="Button" x:Key="OutlineOnHeroButton" BasedOn="{StaticResource OutlineButton}">
        <Setter Property="TextColor" Value="{StaticResource OnHeroMuted}" />
        <Setter Property="BorderColor" Value="{StaticResource OnHeroTileBorder}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="1" />
                            <Setter Property="BackgroundColor" Value="Transparent" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="0.98" />
                            <Setter Property="BackgroundColor" Value="{StaticResource OnHeroTile}" />
                            <Setter Property="TextColor" Value="{StaticResource White}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="BorderlessButton">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource Primary}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HeightRequest" Value="44" />
    </Style>

    <!-- ============ ENTRY ============ -->
    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextMuted}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="16" />
        <!--
            Estado deshabilitado explicito: sin esto el campo se ve igual que uno
            activo y el cajero intenta escribir en el.
        -->
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Focused" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
                            <Setter Property="Opacity" Value="0.6" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

</ResourceDictionary>
