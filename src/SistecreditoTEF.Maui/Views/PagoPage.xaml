<?xml version="1.0" encoding="utf-8" ?>
<local:HioposFlowPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SistecreditoTEF.Maui.ViewModels"
             xmlns:beh="clr-namespace:SistecreditoTEF.Maui.Common.Behaviors"
             xmlns:ctrl="clr-namespace:SistecreditoTEF.Maui.Views.Controls"
             xmlns:local="clr-namespace:SistecreditoTEF.Maui.Views"
             x:Class="SistecreditoTEF.Maui.Views.PagoPage"
             x:DataType="vm:PagoViewModel"
             Shell.NavBarIsVisible="False"
             Title="Realizar pago">
    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20,24,20,28">

            <!--
                Reemplaza a la barra del Shell (ver Shell.NavBarIsVisible arriba).

                SIN PermitirVolverAHiopos: modulo de RECAUDO. La flecha dice "Atras"
                y vuelve a la lista de creditos. Ver CreditosActivosPage.

                PuedeVolver se apaga mientras el abono esta EN VUELO: moverse justo
                ahi deja un cobro que Credinet puede haber aplicado y que la pantalla
                ya no va a poder mostrar. Una vez que el resultado se sabe, vuelve.
            -->
            <ctrl:BackBarView TitleText="Realizar pago"
                              PuedeVolver="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}" />

            <!-- Hero saldo -->
            <ctrl:HeroCardView>
                <ctrl:HeroCardView.Behaviors>
                    <beh:EntranceBehavior />
                </ctrl:HeroCardView.Behaviors>
                <VerticalStackLayout Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{Binding Titulo}" TextColor="{StaticResource White}" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="sistecrédito" TextColor="#99FFFFFF" FontSize="12" FontAttributes="Bold,Italic" />
                    </Grid>
                    <Label Text="{Binding Subtitulo}" TextColor="{StaticResource OnHeroMuted}" FontSize="12" />

                    <Label Text="SALDO PENDIENTE" TextColor="{StaticResource OnHeroMuted}" FontSize="11" CharacterSpacing="1.5" Margin="0,10,0,0" />
                    <Label Text="{Binding SaldoTexto}" TextColor="{StaticResource White}" FontSize="32" FontAttributes="Bold" />

                    <!--
                        Los MISMOS tres importes y los MISMOS rotulos que la lista de
                        creditos, para que el cajero no vea numeros distintos al entrar.
                    -->
                    <Grid ColumnDefinitions="*,*,*" Margin="0,12,0,0" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Mínimo del mes" TextColor="{StaticResource OnHeroMuted}" FontSize="11" />
                            <Label Text="{Binding MinimoTexto}" TextColor="{StaticResource White}" FontSize="15" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Cuota del plan" TextColor="{StaticResource OnHeroMuted}" FontSize="11" />
                            <Label Text="{Binding CuotaTexto}" TextColor="{StaticResource White}" FontSize="15" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="2">
                            <Label Text="Saldar todo" TextColor="{StaticResource OnHeroMuted}" FontSize="11" />
                            <Label Text="{Binding TotalTexto}" TextColor="{StaticResource White}" FontSize="15" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label TextColor="{StaticResource OnHeroMuted}" FontSize="11" Margin="0,6,0,0">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Vence " />
                                <Span Text="{Binding VencimientoTexto}" FontAttributes="Bold" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </ctrl:HeroCardView>

            <!-- Mora: el cajero tiene que saberlo antes de cobrar -->
            <Border IsVisible="{Binding TieneMora}" BackgroundColor="{StaticResource WarningSoft}"
                    Stroke="Transparent" StrokeShape="RoundRectangle 12" Padding="14,12">
                <Label Text="{Binding MoraTexto}" TextColor="{StaticResource Warning}"
                       FontSize="13" FontAttributes="Bold" HorizontalTextAlignment="Center" />
            </Border>

            <!-- Monto a cobrar -->
            <Border Style="{StaticResource Card}">
                <Border.Behaviors>
                    <beh:EntranceBehavior DelayMs="90" />
                </Border.Behaviors>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="¿CUÁNTO VAS A COBRAR?" Style="{StaticResource FieldLabel}" />

                        <!-- Atajos: el monto se elige, no se adivina -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Grid.Column="0" Text="{Binding BotonPagoMinimo}"
                                    Command="{Binding UsarPagoMinimoCommand}"
                                    FontSize="12" HeightRequest="46"
                                    BackgroundColor="{StaticResource PrimaryTint}"
                                    TextColor="{StaticResource PrimaryDark}" />
                            <Button Grid.Column="1" Text="{Binding BotonSaldarTodo}"
                                    Command="{Binding UsarSaldarTodoCommand}"
                                    FontSize="12" HeightRequest="46"
                                    BackgroundColor="{StaticResource PrimaryTint}"
                                    TextColor="{StaticResource PrimaryDark}" />
                        </Grid>

                        <Border Style="{StaticResource FieldCard}">
                            <Grid ColumnDefinitions="Auto,*">
                                <Label Grid.Column="0" Text="$" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                                <!--
                                    Bindeado a MontoTexto (string), NO al decimal: el
                                    punto es separador de miles en es-CO y decimal en
                                    cultura invariante, asi que un binding numerico
                                    podria leer "50.000" como 50. Ver [MoneyInput].

                                    El separador de miles lo pone MoneyEntryBehavior, que
                                    reubica el cursor. Hacerlo desde el ViewModel cerraba
                                    la app al borrar digitos.
                                -->
                                <Entry Grid.Column="1" Keyboard="Numeric" Placeholder="0"
                                       FontSize="24" FontAttributes="Bold" HeightRequest="52"
                                       Text="{Binding MontoTexto, Mode=TwoWay}">
                                    <Entry.Behaviors>
                                        <beh:MoneyEntryBehavior />
                                    </Entry.Behaviors>
                                </Entry>
                            </Grid>
                        </Border>
                        <Label Text="{Binding MontoHint}" Style="{StaticResource Caption}" TextColor="{StaticResource TextMuted}" />

                        <!--
                            Se quitaron por pedido explicito los tres textos
                            explicativos que salian aca:
                              - "el pago minimo no coincide con la cuota porque
                                 incluye intereses o mora"  (ExplicacionMinimo)
                              - "el minimo del mes es mayor al saldo capital"
                                 (AvisoMinimoExcedeSaldo)
                              - "el monto supera el saldo capital pero puede ser
                                 correcto"  (AdvertenciaMonto)

                            Las propiedades siguen existiendo en el ViewModel y no se
                            borraron: solo eran informativas, nunca bloquearon el
                            cobro, y volver a mostrarlas es agregar estas tres lineas.
                            El motivo de bloqueo del boton (MotivoBloqueo) SI se
                            conserva, porque ese explica algo accionable.
                        -->
                    </VerticalStackLayout>
            </Border>

            <!--
                Un boton gris SIN explicacion es de las peores experiencias posibles
                en un POS: el cajero no sabe si es un error del sistema o algo que
                puede corregir. Aca siempre se dice el motivo.
            -->
            <Border IsVisible="{Binding TieneMotivoBloqueo}"
                    BackgroundColor="{StaticResource WarningSoft}"
                    Stroke="Transparent" StrokeShape="RoundRectangle 12" Padding="14,12">
                <Label Text="{Binding MotivoBloqueo}" TextColor="{StaticResource Warning}"
                       FontSize="13" HorizontalTextAlignment="Center" />
            </Border>

            <!-- El boton dice el monto: ultima chance de notar un error -->
            <Button Text="{Binding TextoBotonPagar}"
                    Style="{StaticResource SuccessButton}"
                    Command="{Binding PagarCommand}">
                <Button.Behaviors>
                    <beh:EntranceBehavior DelayMs="170" />
                </Button.Behaviors>
            </Button>

            <ActivityIndicator IsVisible="{Binding IsLoading}" IsRunning="{Binding IsLoading}"
                               Color="{StaticResource Primary}" HeightRequest="36" />

            <Border IsVisible="{Binding HasError}"
                    BackgroundColor="{StaticResource ErrorSoft}"
                    Stroke="Transparent" StrokeShape="RoundRectangle 12" Padding="14,12">
                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Error}" FontSize="13" HorizontalTextAlignment="Center" />
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</local:HioposFlowPage>
