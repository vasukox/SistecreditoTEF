<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SistecreditoTEF.Maui.ViewModels"
             xmlns:beh="clr-namespace:SistecreditoTEF.Maui.Common.Behaviors"
             xmlns:ctrl="clr-namespace:SistecreditoTEF.Maui.Views.Controls"
             x:Class="SistecreditoTEF.Maui.Views.CapturaCedulaPage"
             x:DataType="vm:CapturaCedulaViewModel"
             Shell.NavBarIsVisible="False"
             Title="Pagar a crédito">

    <ctrl:ScaffoldView EyebrowText="Pagar a crédito"
                       TitleText="Consultar cliente"
                       SubtitleText="Ingresa el documento para validar el cupo"
                       ShowBack="True">
        <VerticalStackLayout Spacing="18" Padding="20,24,20,28"
                             MaximumWidthRequest="760" HorizontalOptions="Center">

            <Border Style="{StaticResource Card}">
                <Border.Behaviors>
                    <beh:EntranceBehavior DelayMs="60" />
                </Border.Behaviors>
                <VerticalStackLayout Spacing="20">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="TIPO DE DOCUMENTO" Style="{StaticResource FieldLabel}" />
                        <HorizontalStackLayout Spacing="24">
                            <RadioButton Content="Cédula (CC)"
                                         TextColor="{StaticResource TextPrimary}"
                                         IsChecked="{Binding TipoDocumento, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=CedulaCiudadania}" />
                            <RadioButton Content="Extranjería (CE)"
                                         TextColor="{StaticResource TextPrimary}"
                                         IsChecked="{Binding TipoDocumento, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=CedulaExtranjeria}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="NÚMERO DE DOCUMENTO" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource FieldCard}">
                            <Entry Placeholder="Ej: 1026260942"
                                   Keyboard="Numeric"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   HeightRequest="50"
                                   Text="{Binding NumeroDocumento, Mode=TwoWay}" />
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Button Text="Validar cliente"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding ValidarCommand}">
                <Button.Behaviors>
                    <beh:EntranceBehavior DelayMs="140" />
                </Button.Behaviors>
            </Button>

            <ActivityIndicator IsVisible="{Binding IsLoading}"
                               IsRunning="{Binding IsLoading}"
                               Color="{StaticResource Primary}"
                               HeightRequest="36" />

            <!-- Notificacion de error (tipo toast): icono + titulo + mensaje,
                 con borde izquierdo de color para que se vea como alerta. -->
            <Border IsVisible="{Binding HasError}"
                    BackgroundColor="{StaticResource ErrorSoft}"
                    Stroke="{StaticResource Error}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="14,12">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer />
                    </Grid.GestureRecognizers>
                    <Border Grid.Column="0"
                            BackgroundColor="{StaticResource Error}"
                            WidthRequest="36" HeightRequest="36"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 18"
                            HorizontalOptions="Center" VerticalOptions="Start">
                        <Label Text="!" TextColor="{StaticResource White}"
                               FontSize="20" FontAttributes="Bold"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="No pudimos validar el documento"
                               TextColor="{StaticResource Error}"
                               FontSize="14" FontAttributes="Bold" />
                        <Label Text="{Binding ErrorMessage}"
                               TextColor="{StaticResource TextPrimary}"
                               FontSize="13" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Notificacion de validacion (icono + mensaje corto). -->
            <Border IsVisible="{Binding HasValidation}"
                    BackgroundColor="{StaticResource WarningSoft}"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 12"
                    Padding="14,12">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border Grid.Column="0"
                            BackgroundColor="{StaticResource Warning}"
                            WidthRequest="36" HeightRequest="36"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 18"
                            HorizontalOptions="Center" VerticalOptions="Start">
                        <Label Text="i" TextColor="{StaticResource White}"
                               FontSize="18" FontAttributes="Bold"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Grid.Column="1"
                           Text="{Binding ValidationMessage}"
                           TextColor="{StaticResource TextPrimary}"
                           FontSize="13"
                           VerticalOptions="Center" />
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ctrl:ScaffoldView>
</ContentPage>
