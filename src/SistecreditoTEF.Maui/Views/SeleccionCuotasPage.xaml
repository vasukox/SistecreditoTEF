<?xml version="1.0" encoding="utf-8" ?>
<local:HioposFlowPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SistecreditoTEF.Maui.ViewModels"
             xmlns:beh="clr-namespace:SistecreditoTEF.Maui.Common.Behaviors"
             xmlns:ctrl="clr-namespace:SistecreditoTEF.Maui.Views.Controls"
             xmlns:local="clr-namespace:SistecreditoTEF.Maui.Views"
             xmlns:sys="clr-namespace:System;assembly=netstandard"
             x:Class="SistecreditoTEF.Maui.Views.SeleccionCuotasPage"
             x:DataType="vm:SeleccionCuotasViewModel"
             Shell.NavBarIsVisible="False"
             Title="Simular crédito">
    <ScrollView x:Name="PageScroll">
        <VerticalStackLayout Spacing="20" Padding="20,24,20,28">

            <!--
                Reemplaza a la barra del Shell (ver Shell.NavBarIsVisible arriba):
                trae el titulo y un unico boton atras, que dentro de una venta de
                HioPos dice "Volver a HioPos" y devuelve el control al POS.
            -->
            <ctrl:BackBarView TitleText="Simular crédito" PermitirVolverAHiopos="True" />

            <!-- Hero cupo -->
            <ctrl:HeroCardView>
                <ctrl:HeroCardView.Behaviors>
                    <beh:EntranceBehavior />
                </ctrl:HeroCardView.Behaviors>
                <VerticalStackLayout Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{Binding ClienteNombre}" TextColor="{StaticResource White}" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="sistecrédito" TextColor="#99FFFFFF" FontSize="12" FontAttributes="Bold,Italic" />
                    </Grid>
                    <Label Text="CUPO DISPONIBLE" TextColor="{StaticResource OnHeroMuted}" FontSize="11" CharacterSpacing="1.5" Margin="0,8,0,0" />
                    <Label Text="{Binding CupoDisponible}" TextColor="{StaticResource White}" FontSize="32" FontAttributes="Bold" />
                    <Label TextColor="{StaticResource OnHeroMuted}" FontSize="12">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="de " />
                                <Span Text="{Binding CupoTotal}" FontAttributes="Bold" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </ctrl:HeroCardView>

            <!-- Monto + plazos -->
            <Border Style="{StaticResource Card}">
                <Border.Behaviors>
                    <beh:EntranceBehavior DelayMs="90" />
                </Border.Behaviors>
                <VerticalStackLayout Spacing="18">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="MONTO A SOLICITAR" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource FieldCard}">
                            <Grid ColumnDefinitions="Auto,*">
                                <Label Grid.Column="0" Text="$" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                                <!--
                                    Bindeado a MontoTexto (string), NO al decimal:
                                    "500.000" leido con cultura invariante daria 500.
                                    Ver [MoneyInput].

                                    El separador de miles lo pone MoneyEntryBehavior, que
                                    reubica el cursor. Hacerlo desde el ViewModel cerraba
                                    la app al borrar digitos.
                                -->
                                <Entry Grid.Column="1" Keyboard="Numeric" Placeholder="500.000"
                                       FontSize="24" FontAttributes="Bold" HeightRequest="52"
                                       Text="{Binding MontoTexto, Mode=TwoWay}">
                                    <Entry.Behaviors>
                                        <beh:MoneyEntryBehavior />
                                    </Entry.Behaviors>
                                </Entry>
                            </Grid>
                        </Border>
                        <Label Text="Entre $10.000 y $3.000.000" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="PLAZO — CUOTAS MENSUALES" Style="{StaticResource FieldLabel}" />
                        <!--
                            Solo se ofrecen los plazos que Sistecredito autorizo para
                            este monto. Mientras no responda, la lista esta vacia a
                            proposito y este texto explica por que: antes se ofrecian
                            los 8 plazos y el cajero podia elegir uno no habilitado.
                        -->
                        <Label Text="{Binding MensajePlazos}" Style="{StaticResource Caption}" />
                        <CollectionView ItemsSource="{Binding PlazosDisponibles}"
                                        SelectionMode="Single"
                                        SelectedItem="{Binding MesesSeleccionados, Mode=TwoWay}"
                                        HorizontalScrollBarVisibility="Never"
                                        HeightRequest="52">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                            </CollectionView.ItemsLayout>
                            <!--
                                SIN EmptyView con texto, a proposito.

                                Aca habia otro Label con el MISMO [MensajePlazos] que
                                el de arriba. Cuando no hay plazos —justo el caso en
                                que ese texto importa— la lista queda vacia y el
                                mensaje aparecia DOS VECES, uno debajo del otro.

                                El Label de arriba se muestra siempre y ya explica el
                                estado, asi que la lista vacia no necesita repetirlo.
                            -->
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="sys:Int32">
                                    <Border StrokeShape="RoundRectangle 12"
                                            Stroke="{StaticResource Divider}"
                                            StrokeThickness="1.5"
                                            BackgroundColor="{StaticResource SurfaceAlt}"
                                            Padding="20,8" MinimumWidthRequest="58">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal">
                                                    <VisualState.Setters>
                                                        <Setter Property="Stroke" Value="{StaticResource Divider}" />
                                                        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceAlt}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Selected">
                                                    <VisualState.Setters>
                                                        <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                                        <Setter Property="BackgroundColor" Value="{StaticResource SelectTint}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                        <Label Text="{Binding .}" TextColor="{StaticResource Primary}"
                                               FontAttributes="Bold" FontSize="18"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!--
                El BOTON es el indicador de progreso: cambia a "Calculando…" y se
                apaga mientras hay un calculo en vuelo. Antes el texto quedaba fijo y
                el progreso vivia en un spinner mas abajo, asi que el cajero no tenia
                senal en el elemento que acababa de tocar.

                Apagarlo tambien evita el doble disparo: dos toques seguidos —normales
                en un POS lento— lanzaban dos simulaciones y la segunda respuesta podia
                pisar a la primera.
            -->
            <Button Text="{Binding TextoBotonCalcular}"
                    Style="{StaticResource PrimaryButton}"
                    IsEnabled="{Binding PuedeCalcular}"
                    Command="{Binding CalcularCommand}">
                <Button.Behaviors>
                    <beh:EntranceBehavior DelayMs="170" />
                </Button.Behaviors>
            </Button>

            <!--
                Esqueleto del resultado. Ocupa el lugar exacto donde va a aparecer la
                cuota, con barras que laten despacio, en vez de un spinner suelto que
                no dice donde mirar. Ver [ShimmerBehavior] para el porque del ritmo y
                de como se apaga el bucle.

                Los DelayMs escalonados hacen que se lea como una onda y no como tres
                cosas parpadeando al unisono.
            -->
            <Border IsVisible="{Binding IsLoading}"
                    Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="CALCULANDO CON SISTECRÉDITO"
                           Style="{StaticResource FieldLabel}" />

                    <BoxView HeightRequest="30" CornerRadius="6"
                             Color="{StaticResource Border}"
                             WidthRequest="180" HorizontalOptions="Start">
                        <BoxView.Behaviors>
                            <beh:ShimmerBehavior />
                        </BoxView.Behaviors>
                    </BoxView>

                    <BoxView HeightRequest="14" CornerRadius="5"
                             Color="{StaticResource Border}">
                        <BoxView.Behaviors>
                            <beh:ShimmerBehavior DelayMs="140" />
                        </BoxView.Behaviors>
                    </BoxView>

                    <BoxView HeightRequest="14" CornerRadius="5"
                             WidthRequest="220" HorizontalOptions="Start"
                             Color="{StaticResource Border}">
                        <BoxView.Behaviors>
                            <beh:ShimmerBehavior DelayMs="280" />
                        </BoxView.Behaviors>
                    </BoxView>
                </VerticalStackLayout>
            </Border>

            <Border IsVisible="{Binding HasError}"
                    BackgroundColor="{StaticResource ErrorSoft}"
                    Stroke="Transparent" StrokeShape="RoundRectangle 12" Padding="14,12">
                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Error}" FontSize="13" />
            </Border>

            <!-- Resultado -->
            <Border x:Name="ResultadoCard" IsVisible="{Binding HasResults}" Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="CUOTA MENSUAL" Style="{StaticResource FieldLabel}" />
                    <Label Text="{Binding CuotaMensual}" Style="{StaticResource MoneyLarge}" TextColor="{StaticResource Success}" />
                    <BoxView HeightRequest="1" Color="{StaticResource Divider}" Margin="0,10" />
                    <!--
                        El desglose esta ordenado para que SUME de arriba hacia abajo:
                        monto + intereses + aval con IVA = total a pagar. Asi el cajero
                        (o el cliente) lo verifica de un vistazo, sin subir a buscar el
                        monto en el campo de captura.

                        "Aval + IVA" y no solo "Aval" a proposito: el valor que se
                        muestra es assuranceTotalValue, que incluye el impuesto. Con el
                        rotulo "Aval" y el aval SIN IVA, el desglose no cerraba y
                        faltaban $3.797 que nadie podia explicar.
                    -->
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                        <Label Grid.Row="0" Grid.Column="0" Text="Monto financiado" Style="{StaticResource Caption}" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding MontoFinanciado}" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        <Label Grid.Row="1" Grid.Column="0" Text="Intereses" Style="{StaticResource Caption}" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding Intereses}" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        <Label Grid.Row="2" Grid.Column="0" Text="Aval + IVA" Style="{StaticResource Caption}" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding Aval}" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        <Label Grid.Row="3" Grid.Column="0" Text="Cuota inicial" Style="{StaticResource Caption}" />
                        <Label Grid.Row="3" Grid.Column="1" Text="{Binding CuotaInicial}" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />

                        <BoxView Grid.Row="4" Grid.ColumnSpan="2" HeightRequest="1" Color="{StaticResource Divider}" Margin="0,4" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Total a pagar" Style="{StaticResource Caption}" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="{Binding TotalPagar}" FontAttributes="Bold" FontSize="17" TextColor="{StaticResource TextPrimary}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button Text="Confirmar crédito"
                    IsVisible="{Binding HasResults}"
                    Style="{StaticResource SuccessButton}"
                    Command="{Binding ContinuarCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</local:HioposFlowPage>
