<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SistecreditoTEF.Maui.ViewModels"
             xmlns:beh="clr-namespace:SistecreditoTEF.Maui.Common.Behaviors"
             xmlns:ctrl="clr-namespace:SistecreditoTEF.Maui.Views.Controls"
             x:Class="SistecreditoTEF.Maui.Views.ValidacionClientePage"
             x:DataType="vm:ValidacionClienteViewModel"
             Title="Cliente">
    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20,24,20,28">

            <VerticalStackLayout Spacing="4">
                <VerticalStackLayout.Behaviors>
                    <beh:EntranceBehavior />
                </VerticalStackLayout.Behaviors>
                <Label Text="Cliente validado" Style="{StaticResource ScreenTitle}" />
                <Label Text="Confirma los datos antes de continuar" Style="{StaticResource ScreenSubtitle}" />
            </VerticalStackLayout>

            <!-- Hero: cupo disponible -->
            <ctrl:HeroCardView>
                <ctrl:HeroCardView.Behaviors>
                    <beh:EntranceBehavior DelayMs="90" />
                </ctrl:HeroCardView.Behaviors>
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{Binding ClientName}" TextColor="{StaticResource White}" FontSize="20" FontAttributes="Bold" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="sistecrédito" TextColor="#99FFFFFF" FontSize="12" FontAttributes="Bold,Italic" VerticalOptions="Start" />
                    </Grid>
                    <Border BackgroundColor="#33FFFFFF" Stroke="Transparent" StrokeShape="RoundRectangle 20"
                            Padding="12,4" HorizontalOptions="Start">
                        <Label Text="{Binding Estado}" TextColor="{StaticResource White}" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" />
                    </Border>
                    <BoxView HeightRequest="1" Color="#33FFFFFF" Margin="0,12" />
                    <Label Text="CUPO DISPONIBLE" TextColor="{StaticResource OnHeroMuted}" FontSize="12" CharacterSpacing="1.5" />
                    <Label Text="{Binding AvailableLimit}" TextColor="{StaticResource White}" FontSize="36" FontAttributes="Bold" />
                    <Label TextColor="{StaticResource OnHeroMuted}" FontSize="12">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Cupo total: " />
                                <Span Text="{Binding CreditLimit}" FontAttributes="Bold" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </ctrl:HeroCardView>

            <!-- Contacto -->
            <Border Style="{StaticResource Card}">
                <Border.Behaviors>
                    <beh:EntranceBehavior DelayMs="170" />
                </Border.Behaviors>
                <VerticalStackLayout Spacing="14">
                    <Label Text="DATOS DE CONTACTO" Style="{StaticResource FieldLabel}" />
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                        <Label Grid.Row="0" Grid.Column="0" Text="Email" Style="{StaticResource Caption}" VerticalOptions="Center" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding ClientEmail}" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalTextAlignment="End" />
                        <Label Grid.Row="1" Grid.Column="0" Text="Móvil" Style="{StaticResource Caption}" VerticalOptions="Center" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding ClientMobile}" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalTextAlignment="End" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button Text="Continuar"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding ContinuarCommand}">
                <Button.Behaviors>
                    <beh:EntranceBehavior DelayMs="240" />
                </Button.Behaviors>
            </Button>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
