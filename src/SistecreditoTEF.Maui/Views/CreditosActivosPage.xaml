<?xml version="1.0" encoding="utf-8" ?>
<local:HioposFlowPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SistecreditoTEF.Maui.ViewModels"
             xmlns:models="clr-namespace:SistecreditoTEF.Maui.Models"
             xmlns:beh="clr-namespace:SistecreditoTEF.Maui.Common.Behaviors"
             xmlns:ctrl="clr-namespace:SistecreditoTEF.Maui.Views.Controls"
             xmlns:local="clr-namespace:SistecreditoTEF.Maui.Views"
             x:Class="SistecreditoTEF.Maui.Views.CreditosActivosPage"
             x:DataType="vm:CreditosActivosViewModel"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Flyout"
             Title="Pagar crédito">

    <!--
        SIN PermitirVolverAHiopos, a proposito.

        Este es el modulo de RECAUDO ("pagar credito"), y aca la flecha es solo para
        moverse dentro del flujo. "Volver a HioPos" pertenece al modulo de VENTA
        ("pagar a credito"), que es donde el cajero eligio Sistecredito como medio de
        pago y puede arrepentirse. El boton fisico del POS SI sigue devolviendo el
        control (ver HioposFlowPage): sin eso, salirse dejaria a HioPos esperando un
        resultado que nunca llega.
    -->
    <ctrl:ScaffoldView TitleText="Pagar crédito"
                       SubtitleText="Consulta los créditos pendientes del cliente"
                       ShowBack="True">
        <VerticalStackLayout Spacing="18" Padding="20,24,20,28"
                             MaximumWidthRequest="760" HorizontalOptions="Center">

            <!-- Búsqueda -->
            <Border Style="{StaticResource Card}">
                <Border.Behaviors>
                    <beh:EntranceBehavior DelayMs="60" />
                </Border.Behaviors>
                <VerticalStackLayout Spacing="18">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="TIPO DE DOCUMENTO" Style="{StaticResource FieldLabel}" />
                        <HorizontalStackLayout Spacing="24">
                            <RadioButton Content="Cédula (CC)" TextColor="{StaticResource TextPrimary}"
                                         IsChecked="{Binding TipoDocumento, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=CedulaCiudadania}" />
                            <RadioButton Content="Extranjería (CE)" TextColor="{StaticResource TextPrimary}"
                                         IsChecked="{Binding TipoDocumento, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=CedulaExtranjeria}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="NÚMERO DE DOCUMENTO" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource FieldCard}">
                            <Entry Keyboard="Numeric" Placeholder="Ej: 1026260942"
                                   FontSize="20" FontAttributes="Bold" HeightRequest="50"
                                   Text="{Binding NumeroDocumento, Mode=TwoWay}" />
                        </Border>
                    </VerticalStackLayout>
                    <Button Text="Buscar créditos" Style="{StaticResource PrimaryButton}"
                            Command="{Binding BuscarCommand}" />
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsVisible="{Binding IsLoading}" IsRunning="{Binding IsLoading}"
                               Color="{StaticResource Primary}" HeightRequest="36" />

            <Border IsVisible="{Binding IsEmpty}" BackgroundColor="{StaticResource WarningSoft}"
                    Stroke="Transparent" StrokeShape="RoundRectangle 12" Padding="16,14">
                <Label Text="El cliente no tiene créditos activos." TextColor="{StaticResource Warning}"
                       FontSize="13" HorizontalTextAlignment="Center" />
            </Border>

            <Border IsVisible="{Binding HasError}" BackgroundColor="{StaticResource ErrorSoft}"
                    Stroke="Transparent" StrokeShape="RoundRectangle 12" Padding="16,14">
                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Error}"
                       FontSize="13" HorizontalTextAlignment="Center" />
            </Border>

            <CollectionView ItemsSource="{Binding Creditos}" IsVisible="{Binding HasResults}"
                            SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="14" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ActiveCredit">
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="{Binding CreditNumber, StringFormat='Crédito #{0}'}"
                                           Style="{StaticResource CardTitle}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding StoreName}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                                </Grid>
                                <Label Text="SALDO PENDIENTE" Style="{StaticResource FieldLabel}" />
                                <Label Text="{Binding Balance, StringFormat='$ {0:N0}'}" Style="{StaticResource MoneyLarge}" />

                                <!--
                                    Los MISMOS tres importes con los MISMOS rotulos que la
                                    pantalla de cobro.

                                    Antes esta tarjeta mostraba solo "Cuota" (FeeValue) y la
                                    pantalla de cobro precargaba el "Pago minimo"
                                    (MinimumPayment), que es OTRO campo de Credinet. El cajero
                                    veia un monto afuera y otro distinto al entrar, y parecia
                                    un error del sistema.
                                -->
                                <Grid ColumnDefinitions="*,*,*" RowSpacing="2" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0" Spacing="1">
                                        <Label Text="Pago mínimo" Style="{StaticResource Caption}" />
                                        <Label Text="{Binding MinimumPayment, StringFormat='$ {0:N0}'}" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="1">
                                        <Label Text="Cuota" Style="{StaticResource Caption}" />
                                        <Label Text="{Binding FeeValue, StringFormat='$ {0:N0}'}" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" Spacing="1">
                                        <Label Text="Vencimiento" Style="{StaticResource Caption}" />
                                        <Label Text="{Binding DueDateDisplay}" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                    </VerticalStackLayout>
                                </Grid>

                                <!-- Mora: dato que cambia la decision del cajero -->
                                <Label Text="{Binding ArrearsDays, StringFormat='En mora: {0} días'}"
                                       IsVisible="{Binding EstaEnMora}"
                                       TextColor="{StaticResource Warning}"
                                       FontSize="12" FontAttributes="Bold" />

                                <Button Text="Cobrar este crédito"
                                        Style="{StaticResource SuccessButton}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CreditosActivosViewModel}}, Path=SeleccionarCommand}"
                                        CommandParameter="{Binding .}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ctrl:ScaffoldView>
</local:HioposFlowPage>
