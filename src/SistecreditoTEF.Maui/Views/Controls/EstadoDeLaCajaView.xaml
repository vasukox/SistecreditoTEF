<?xml version="1.0" encoding="utf-8" ?>
<!--
    EstadoDeLaCajaView — la franja que esta SIEMPRE arriba.

    Dos datos, uno en cada punta:

      izquierda   que tienda es esta caja   "037 · MULTIMARCA PUNTO CALLE 18"
      derecha     si hay red                "En linea" / "Sin conexion"

    POR QUE LA TIENDA VA A LA IZQUIERDA Y SIEMPRE
    El modulo se ve identico en las 76 tiendas. Cuando una caja quedo asociada a la
    tienda equivocada, nada en pantalla lo delataba: los creditos se registraban a
    nombre de otra y se descubria conciliando semanas despues. Teniendolo arriba a
    la izquierda, cualquiera que pase por la caja lo ve sin buscarlo.

    Los colores vienen en dos juegos ([SobreOscuro]): el control vive tanto dentro
    de la cabecera azul como sobre el fondo claro de las pantallas de configuracion.
    Un solo juego obligaria a elegir cual de los dos se lee mal.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SistecreditoTEF.Maui.Views.Controls.EstadoDeLaCajaView">
    <ContentView.ControlTemplate>
        <ControlTemplate>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalOptions="Center">

                <!-- ============ TIENDA ============ -->
                <Border x:Name="PART_TiendaChip" Grid.Column="0"
                        HorizontalOptions="Start"
                        Stroke="Transparent" StrokeThickness="1"
                        StrokeShape="RoundRectangle 14" Padding="11,5">
                    <Label x:Name="PART_Tienda"
                           FontSize="12" FontAttributes="Bold"
                           CharacterSpacing="0.4"
                           LineBreakMode="TailTruncation"
                           MaximumWidthRequest="320"
                           VerticalOptions="Center" />
                </Border>

                <!-- ============ CONEXION ============ -->
                <Border x:Name="PART_RedChip" Grid.Column="1"
                        Stroke="Transparent" StrokeThickness="1"
                        StrokeShape="RoundRectangle 14" Padding="11,5">
                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="7" VerticalOptions="Center">
                        <!--
                            Punto de color ADEMAS del texto, nunca en lugar del
                            texto: en un POS con reflejos el color solo no se
                            distingue, y hay cajeros que no diferencian verde de
                            rojo. El que informa es el texto; el punto ayuda a
                            encontrarlo de un vistazo.
                        -->
                        <BoxView x:Name="PART_Punto" Grid.Column="0"
                                 WidthRequest="9" HeightRequest="9" CornerRadius="5"
                                 VerticalOptions="Center" />
                        <Label x:Name="PART_Red" Grid.Column="1"
                               FontSize="12" FontAttributes="Bold"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

            </Grid>
        </ControlTemplate>
    </ContentView.ControlTemplate>
</ContentView>
