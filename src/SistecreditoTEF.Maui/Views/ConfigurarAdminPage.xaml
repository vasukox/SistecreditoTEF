<?xml version="1.0" encoding="utf-8" ?>
<!--
    CREAR EL PIN DE ADMINISTRADOR. Y nada mas.

    ─────────────────────────────────────────────────────────────────────────────
    LO QUE SE FUE DE ESTA PANTALLA, Y POR QUE
    ─────────────────────────────────────────────────────────────────────────────
    Tenia tres cosas: la tienda de la caja, el atajo para copiar de otra caja y el
    formulario del PIN. Las tres a la vez, una debajo de la otra.

      · La TIENDA ahora es el paso 1 del montaje, en su propia pantalla, y ademas
        queda a la vista en la franja de estado de todas las pantallas.
      · COPIAR DE OTRA CAJA ahora es una de las dos opciones del paso 2.

    Lo que quedo es un formulario con dos campos. Quien llega aqui ya eligio este
    camino en el paso anterior, asi que la pantalla no tiene que volver a
    ofrecerle los otros — los deja al final, en chico, para el que se equivoco de
    boton.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SistecreditoTEF.Maui.ViewModels"
             xmlns:beh="clr-namespace:SistecreditoTEF.Maui.Common.Behaviors"
             xmlns:ctrl="clr-namespace:SistecreditoTEF.Maui.Views.Controls"
             x:Class="SistecreditoTEF.Maui.Views.ConfigurarAdminPage"
             x:DataType="vm:ConfigurarAdminViewModel"
             Shell.NavBarIsVisible="False"
             Title="Configuración inicial">

    <ctrl:ScaffoldView x:Name="Chrome"
                       EyebrowText="CONFIGURAR DE CERO"
                       TitleText="PIN de administrador"
                       SubtitleText="Con este PIN se administran los cajeros"
                       ShowBack="True">

        <VerticalStackLayout Spacing="18" Padding="20,22,20,28"
                             MaximumWidthRequest="820" HorizontalOptions="Center">

            <Border Style="{StaticResource Card}">
                <Border.Behaviors>
                    <beh:EntranceBehavior />
                </Border.Behaviors>
                <VerticalStackLayout Spacing="14">
                    <Label Text="PIN DE ADMINISTRADOR" Style="{StaticResource FieldLabel}" />

                    <Border Style="{StaticResource FieldCard}">
                        <Entry Keyboard="Numeric" IsPassword="True" Placeholder="••••"
                               FontSize="22" HeightRequest="52"
                               Text="{Binding Pin, Mode=TwoWay}" />
                    </Border>

                    <Label Text="REPITA EL PIN" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource FieldCard}">
                        <Entry Keyboard="Numeric" IsPassword="True" Placeholder="••••"
                               FontSize="22" HeightRequest="52"
                               Text="{Binding PinConfirmacion, Mode=TwoWay}" />
                    </Border>

                    <Label Text="{Binding Ayuda}" Style="{StaticResource Caption}"
                           TextColor="{StaticResource TextMuted}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Crear PIN y continuar"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding GuardarCommand}">
                <Button.Behaviors>
                    <beh:EntranceBehavior DelayMs="90" />
                    <beh:PressableBehavior />
                </Button.Behaviors>
            </Button>

            <!-- Un botón gris sin explicación deja al instalador sin saber qué falta. -->
            <Label Text="{Binding MotivoBloqueo}" Style="{StaticResource Caption}"
                   TextColor="{StaticResource TextMuted}"
                   HorizontalTextAlignment="Center" />

            <Border IsVisible="{Binding TieneError}" BackgroundColor="{StaticResource WarningSoft}"
                    Stroke="Transparent" StrokeShape="RoundRectangle 12" Padding="14,12">
                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Warning}"
                       FontSize="13" HorizontalTextAlignment="Center" />
            </Border>

            <!--
                LAS SALIDAS, EN CHICO Y AL FINAL.
                No son el camino de esta pantalla —se eligieron o se descartaron en
                el paso anterior— pero tienen que seguir existiendo: el que entro
                aqui por error no puede quedarse encerrado creando un PIN que no
                hacia falta.
            -->
            <BoxView HeightRequest="1" Color="{StaticResource Divider}" Margin="0,4" />

            <Label Text="¿NO ERA ESTE EL CAMINO?" Style="{StaticResource FieldLabel}"
                   HorizontalTextAlignment="Center" />

            <Button Text="Copiar la configuración de otra caja"
                    Style="{StaticResource OutlineButton}"
                    Command="{Binding CopiarDeOtraCajaCommand}">
                <Button.Behaviors>
                    <beh:PressableBehavior />
                </Button.Behaviors>
            </Button>

            <Button Text="Cambiar la tienda de esta caja"
                    Style="{StaticResource OutlineButton}"
                    Command="{Binding ElegirTiendaCommand}">
                <Button.Behaviors>
                    <beh:PressableBehavior />
                </Button.Behaviors>
            </Button>

            <!--
                Qué build tiene esta caja y contra qué ambiente apunta.
                ApplicationVersion está fijo en 1 por contrato con ICG, así que sin
                esto la única forma de saberlo era la fecha del .apk en la máquina de
                quien compiló. Los dos APK se llaman igual y se ven igual: si un
                terminal de pruebas quedó con el productivo, acá se nota.
            -->
            <Label Text="{Binding Build}" Style="{StaticResource Caption}"
                   TextColor="{StaticResource TextMuted}"
                   FontSize="11"
                   HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ctrl:ScaffoldView>
</ContentPage>
