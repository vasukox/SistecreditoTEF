<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SistecreditoTEF.Maui.ViewModels"
             xmlns:beh="clr-namespace:SistecreditoTEF.Maui.Common.Behaviors"
             xmlns:ctrl="clr-namespace:SistecreditoTEF.Maui.Views.Controls"
             x:Class="SistecreditoTEF.Maui.Views.IngresoCajeroPage"
             x:DataType="vm:IngresoCajeroViewModel"
             Shell.FlyoutBehavior="Flyout"
             Shell.NavBarIsVisible="False"
             Title="Ingreso">

    <!--
        La tarjeta azul del titulo se fue: la cabecera del [ScaffoldView] dice lo
        mismo y ademas trae la franja de estado —que tienda es esta caja y si hay
        red—, que es justo lo que el cajero quiere saber antes de empezar a cobrar.
        Dos cabeceras apiladas empujaban el formulario fuera de la primera pantalla.

        Sin boton de volver: esta es la puerta del modulo de abonos y detras no hay
        nada a donde volver.
    -->
    <ctrl:ScaffoldView x:Name="Chrome"
                       EyebrowText="PAGO DE CRÉDITO"
                       TitleText="Ingreso del cajero"
                       SubtitleText="Entra con tu usuario y clave para registrar abonos"
                       TrailingText="Sistecrédito"
                       ShowBack="False">
        <VerticalStackLayout Spacing="20" Padding="20,24,20,28"
                             MaximumWidthRequest="820" HorizontalOptions="Center">

            <!--
                Panel de ingreso. Reemplazó la lista de cajeros para elegir: esa
                lista publicaba quiénes trabajan en la tienda ante cualquiera que
                agarrara el terminal, y dejaba el ingreso a un solo dato secreto.
            -->
            <Border Style="{StaticResource Card}">
                <Border.Behaviors>
                    <beh:EntranceBehavior DelayMs="90" />
                </Border.Behaviors>
                <VerticalStackLayout Spacing="14">

                    <Label Text="USUARIO" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource FieldCard}">
                        <Entry Placeholder="usuario"
                               Keyboard="Text"
                               IsTextPredictionEnabled="False"
                               IsSpellCheckEnabled="False"
                               FontSize="18" HeightRequest="52"
                               Text="{Binding Usuario, Mode=TwoWay}" />
                    </Border>

                    <Label Text="CLAVE" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource FieldCard}">
                        <Entry IsPassword="True" Placeholder="••••"
                               FontSize="18" HeightRequest="52"
                               Text="{Binding Clave, Mode=TwoWay}" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Button Text="Ingresar"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding IngresarCommand}">
                <Button.Behaviors>
                    <beh:EntranceBehavior DelayMs="160" />
                    <beh:PressableBehavior />
                </Button.Behaviors>
            </Button>

            <Label Text="{Binding MotivoBloqueo}" Style="{StaticResource Caption}"
                   TextColor="{StaticResource TextMuted}"
                   HorizontalTextAlignment="Center" />

            <Border IsVisible="{Binding TieneError}" BackgroundColor="{StaticResource WarningSoft}"
                    Stroke="Transparent" StrokeShape="RoundRectangle 12" Padding="14,12">
                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Warning}"
                       FontSize="13" HorizontalTextAlignment="Center" />
            </Border>

            <!--
                La entrada a administracion. Es el unico acceso que queda ahora que
                esta pantalla no muestra la barra del Shell, y es suficiente: la
                pantalla destino pide el PIN de administrador antes de mostrar nada.
            -->
            <Button Text="Administración"
                    Command="{Binding IrAAdministracionCommand}"
                    Style="{StaticResource OutlineButton}">
                <Button.Behaviors>
                    <beh:PressableBehavior />
                </Button.Behaviors>
            </Button>

        </VerticalStackLayout>
    </ctrl:ScaffoldView>
</ContentPage>
