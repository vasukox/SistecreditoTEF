<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SistecreditoTEF.Maui.ViewModels"
             xmlns:beh="clr-namespace:SistecreditoTEF.Maui.Common.Behaviors"
             x:Class="SistecreditoTEF.Maui.Views.ReciboPagoPage"
             x:DataType="vm:ReciboPagoViewModel"
             Title="Recibo de pago">
    <ScrollView>
        <VerticalStackLayout Spacing="18" Padding="24,32,24,28">

            <Border WidthRequest="88" HeightRequest="88" BackgroundColor="{StaticResource Success}"
                    Stroke="Transparent" StrokeShape="RoundRectangle 44" HorizontalOptions="Center">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource SuccessBrush}" Offset="0,6" Radius="16" Opacity="0.35" />
                </Border.Shadow>
                <Border.Behaviors>
                    <beh:PopInBehavior DelayMs="120" />
                </Border.Behaviors>
                <Label Text="✓" FontSize="46" FontAttributes="Bold" TextColor="{StaticResource White}"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                <VerticalStackLayout.Behaviors>
                    <beh:EntranceBehavior DelayMs="220" />
                </VerticalStackLayout.Behaviors>
                <Label Text="¡Pago realizado!" Style="{StaticResource ScreenTitle}" HorizontalOptions="Center" />
                <Label Text="{Binding NumeroPago, StringFormat='Abono {0}'}" Style="{StaticResource ScreenSubtitle}" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Monto pagado destacado -->
            <Border Style="{StaticResource Card}">
                <Border.Behaviors>
                    <beh:EntranceBehavior DelayMs="300" />
                </Border.Behaviors>
                <VerticalStackLayout Spacing="6">
                    <!--
                        La cifra destacada es el TOTAL pagado, no el capital.
                        Antes acá iba "ABONO A CAPITAL" con CapitalPagado, que es
                        solo la parte aplicada a capital: el cajero cobraba
                        $100.000 y la pantalla encabezaba con otro número. El
                        capital pasó al desglose, donde se entiende de dónde sale.
                    -->
                    <Label Text="TOTAL PAGADO" Style="{StaticResource FieldLabel}" />
                    <Label Text="{Binding TotalPagado}" Style="{StaticResource MoneyLarge}" TextColor="{StaticResource Success}" />

                    <BoxView HeightRequest="1" Color="{StaticResource Divider}" Margin="0,10" />

                    <!-- Desglose: cada concepto solo si tiene valor. -->
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                        <Label Grid.Row="0" Grid.Column="0" Text="Abonado a capital" Style="{StaticResource Caption}" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding CapitalPagado}" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />

                        <Label Grid.Row="1" Grid.Column="0" Text="Intereses" Style="{StaticResource Caption}"
                               IsVisible="{Binding TieneIntereses}" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding InteresesPagados}" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" IsVisible="{Binding TieneIntereses}" />

                        <Label Grid.Row="2" Grid.Column="0" Text="Mora" Style="{StaticResource Caption}"
                               IsVisible="{Binding TieneMora}" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding MoraPagada}" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" IsVisible="{Binding TieneMora}" />

                        <Label Grid.Row="3" Grid.Column="0" Text="Aval" Style="{StaticResource Caption}"
                               IsVisible="{Binding TieneAval}" />
                        <Label Grid.Row="3" Grid.Column="1" Text="{Binding AvalPagado}" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" IsVisible="{Binding TieneAval}" />

                        <Label Grid.Row="4" Grid.Column="0" Text="Otros cargos" Style="{StaticResource Caption}"
                               IsVisible="{Binding TieneOtrosCargos}" />
                        <Label Grid.Row="4" Grid.Column="1" Text="{Binding OtrosCargos}" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" IsVisible="{Binding TieneOtrosCargos}" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource Divider}" Margin="0,10" />

                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                        <Label Grid.Row="0" Grid.Column="0" Text="Saldo restante" Style="{StaticResource Caption}" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding SaldoRestante}" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                        <Label Grid.Row="1" Grid.Column="0" Text="Próximo pago" Style="{StaticResource Caption}" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding ProximoPago}" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        <Label Grid.Row="2" Grid.Column="0" Text="Próximo mínimo" Style="{StaticResource Caption}" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding ProximoMinimo}" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!--
                Dos salidas explicitas en vez de un solo "Finalizar" que imprimia
                siempre. La accion que se toca y lo que pasa coinciden, sin estados
                intermedios ni casillas que el cajero pueda no ver.
            -->
            <!--
                Va en verde lima (el acento de la marca): es el momento de cierre
                positivo del cobro. Con texto oscuro, que es la unica combinacion
                legible sobre ese color.
            -->
            <Button Text="Imprimir y finalizar"
                    Style="{StaticResource AccentButton}"
                    Command="{Binding ImprimirYFinalizarCommand}">
                <Button.Behaviors>
                    <beh:EntranceBehavior DelayMs="380" />
                </Button.Behaviors>
            </Button>

            <Button Text="Finalizar sin imprimir"
                    Command="{Binding FinalizarSinImprimirCommand}"
                    Style="{StaticResource OutlineButton}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
