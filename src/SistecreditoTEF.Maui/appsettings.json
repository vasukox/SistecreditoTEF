// ════════════════════════════════════════════════════════════════════════════
// PRUEBAS (SANDBOX) — ESTE ES EL QUE SE COMPILA POR DEFECTO
// ════════════════════════════════════════════════════════════════════════════
// Apunta al ambiente de pruebas de Credinet. La SubscriptionKey es el marcador
// __SANDBOX__, que el modulo resuelve a la clave publica del manual: es publica
// por definicion y solo sirve para pruebas.
//
// Para compilar PRODUCCION hay que pedirlo explicitamente:
//
//     dotnet build -c Release -f net10.0-android -p:Ambiente=produccion
//
// y eso empaqueta appsettings.produccion.json en lugar de este archivo.
//
// La asimetria es deliberada: un build sin parametros tiene que salir apuntando
// a sandbox. Ya paso una vez al reves —se instalo el APK productivo en una
// terminal de pruebas, apuntando a posprod con la clave real— y esa es
// exactamente la clase de error que esta separacion evita.
//
// Como verificar cual quedo instalado, en el log del INITIALIZE:
//     env=sandbox     -> este
//     env=production  -> appsettings.produccion.json
//
// El package es el MISMO en los dos (com.permoda.sistecreditotef), asi que
// instalar uno REEMPLAZA al otro en la terminal. No pueden convivir.
{
  "Credinet": {
    "Environment": "sandbox",

    // Marcador: el modulo lo reemplaza por la clave publica de pruebas.
    "SubscriptionKey": "__SANDBOX__",

    // Vacio en pruebas: sandbox no exige tienda.
    "StoreId": "",

    // Ambiente de pruebas: /pos (produccion es /posprod).
    "BaseUrl": "https://api.credinet.co/pos/",

    "StoreName": "Permoda",
    "OtpDestination": 1,
    "Frequency": 30,
    "Source": "2",
    "AuthMethod": 1,
    "TimeoutSeconds": 30,

    "OtpResendCooldownSeconds": 60,
    "OtpMaxResends": 3,
    "OtpVerifyCooldownSeconds": 2,
    "OtpMaxVerifyAttempts": 3,

    // Medios de pago. El recaudo entra en EFECTIVO; la venta consolida sobre el
    // medio tarjeta. Se pueden corregir por HioPosCloud con
    // PAYMENT_MEAN_ID_RECAUDO / PAYMENT_MEAN_ID_VENTA.
    "PaymentMeanIdRecaudo": "1",
    "PaymentMeanIdVenta": "2",

    "CertificatePins": []
  },

  "Printing": {
    "EnableSunmiNative": false
  }
}
